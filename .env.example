# ── AWS credentials for S3 image downloads (boto3) ───────────────────────────
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=us-east-1

# ── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
RELOAD=0

# ── Inference ────────────────────────────────────────────────────────────────
# Torch device: "cpu" or "cuda" (or "cuda:0", etc.)
DEVICE=cpu

# Paths — defaults resolve to ./ml_models/<filename>
MODELS_DIR=ml_models
GENDER_CHECKPOINT=gender_classifier_best.pt
CATEGORY_CHECKPOINT=category_classifier_best.pt

# ── Azure OpenAI (GPT fallback) ──────────────────────────────────────────────
# Required only when gpt_fallback=true in requests.
AZURE_OPENAI_ENDPOINT=https://your-resource.services.ai.azure.com/openai/v1
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
# Deployment name for the vision-capable model (e.g. gpt-4o, gpt-5.4)
AZURE_OPENAI_DEPLOYMENT=gpt-4o
# Retry settings for GPT fallback calls
GPT_MAX_RETRIES=3
GPT_RETRY_DELAY_SECONDS=1.0

# ── Batch + fetch limits ─────────────────────────────────────────────────────
MAX_BATCH_SIZE=32
FETCH_WORKERS=8
HTTP_TIMEOUT_SECONDS=20
MAX_IMAGE_BYTES=26214400
